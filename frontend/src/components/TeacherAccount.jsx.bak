import React, { useState } from 'react';
import api from '../services/api';
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import './TeacherAccount.css';

const TeacherAccount = ({ userData, onLogout, token }) => {
  const displayName = userData?.name || userData?.login || 'Преподаватель';

  const [sessionForm, setSessionForm] = useState({
    subjectId: '',
    groupIds: '',
    lessonName: '',
    expiresMinutes: 20
  });
  const [statsForm, setStatsForm] = useState({
    groupId: '',
    subjectId: ''
  });
  const [sessionLoading, setSessionLoading] = useState(false);
  const [statsLoading, setStatsLoading] = useState(false);
  const [sessionError, setSessionError] = useState('');
  const [statsError, setStatsError] = useState('');
  const [sessionResult, setSessionResult] = useState(null);
  const [statsResult, setStatsResult] = useState(null);
  const [activeTab, setActiveTab] = useState('sessions');

  const parseGroupIds = (value) =>
    value
      .split(',')
      .map((id) => parseInt(id.trim(), 10))
      .filter((id) => !Number.isNaN(id));

  const handleSessionInputChange = (e) => {
    const { name, value } = e.target;
    setSessionForm((prev) => ({
      ...prev,
      [name]: name === 'expiresMinutes' ? parseInt(value, 10) || '' : value
    }));
  };

  const handleStatsInputChange = (e) => {
    const { name, value } = e.target;
    setStatsForm((prev) => ({
      ...prev,
      [name]: value
    }));
  };

  const buildSessionPayload = () => {
    const payload = {};
    const subjectId = parseInt(sessionForm.subjectId, 10);
    const groupIds = parseGroupIds(sessionForm.groupIds);

    if (!Number.isNaN(subjectId) && sessionForm.subjectId !== '') {
      payload.subjectId = subjectId;
    }
    if (groupIds.length > 0) {
      payload.groupIds = groupIds;
    }
    if (sessionForm.lessonName.trim()) {
      payload.lessonName = sessionForm.lessonName.trim();
    }
    if (sessionForm.expiresMinutes && !Number.isNaN(sessionForm.expiresMinutes)) {
      payload.expiresMinutes = Number(sessionForm.expiresMinutes);
    }
    return payload;
  };

  const handleCreateSession = async (e) => {
    e.preventDefault();
    setSessionError('');
    setSessionResult(null);
    setSessionLoading(true);

    try {
      const payload = buildSessionPayload();
      const response = await api.createAttendanceLink(token, payload);
      setSessionResult(response);
    } catch (err) {
      setSessionError(api.getErrorMessage(err, 'Ошибка при создании сессии'));
      console.error('Create session error:', err);
    } finally {
      setSessionLoading(false);
    }
  };

  const handleCreateNearestSession = async () => {
    setSessionError('');
    setSessionResult(null);
    setSessionLoading(true);

    try {
      const response = await api.createAttendanceLink(token, {
        expiresMinutes: sessionForm.expiresMinutes && !Number.isNaN(sessionForm.expiresMinutes)
          ? Number(sessionForm.expiresMinutes)
          : 20
      });
      setSessionResult(response);
    } catch (err) {
      setSessionError(api.getErrorMessage(err, 'Ошибка при создании сессии по расписанию'));
      console.error('Create nearest session error:', err);
    } finally {
      setSessionLoading(false);
    }
  };

  const handleGetStats = async (e) => {
    e.preventDefault();
    setStatsError('');
    setStatsResult(null);
    setStatsLoading(true);

    try {
      const groupId = parseInt(statsForm.groupId, 10);
      const subjectId = statsForm.subjectId === '' ? null : parseInt(statsForm.subjectId, 10);
      if (Number.isNaN(groupId)) {
        throw new Error('Укажите корректный ID группы');
      }
      const response = await api.getGroupStats(token, groupId, subjectId);
      setStatsResult(response);
    } catch (err) {
      setStatsError(api.getErrorMessage(err, 'Ошибка при получении статистики'));
      console.error('Get stats error:', err);
    } finally {
      setStatsLoading(false);
    }
  };

  const attendanceData = statsResult?.students?.map((student) => ({
    name: student.student_name,
    attendance: Number(student.attendance_percent) || 0
  })) || [];
  const averageAttendance = attendanceData.length
    ? attendanceData.reduce((sum, item) => sum + item.attendance, 0) / attendanceData.length
    : null;

  return (
    <div className="teacher-account">
      <div className="teacher-header">
        <div className="teacher-info">
          <h1>EJournal Dashboard</h1>
          <p className="teacher-subtitle">
            Пользователь: <strong>{displayName}</strong> | Роль: <strong>{userData?.role || 'teacher'}</strong> | ID: <strong>{userData?.user_id || userData?.id}</strong>
          </p>
        </div>
        <div className="teacher-actions">
          <button className="update-profile-btn">Обновить профиль</button>
          <button className="logout-btn" onClick={onLogout}>Выйти</button>
        </div>
      </div>

      <div className="teacher-tabs">
        <button
          className={'tab-btn ' + (activeTab === 'sessions' ? 'active' : '')}
          onClick={() => setActiveTab('sessions')}
        >
          Создать сессию
        </button>
        <button
          className={'tab-btn ' + (activeTab === 'statistics' ? 'active' : '')}
          onClick={() => setActiveTab('statistics')}
        >
          Статистика группы
        </button>
        <button
          className={'tab-btn ' + (activeTab === 'charts' ? 'active' : '')}
          onClick={() => setActiveTab('charts')}
        >
          Графики
        </button>
      </div>

      {activeTab === 'sessions' && (
        <div className="teacher-section">
          <h2>Преподаватель: создать сессию</h2>
          <p className="section-note">Если не указать предмет и группу, система использует ближайшее занятие из расписания.</p>

          <form onSubmit={handleCreateSession} className="teacher-form">
            <div className="form-group">
              <label htmlFor="subjectId">Subject ID (опционально)</label>
              <input
                id="subjectId"
                type="number"
                name="subjectId"
                value={sessionForm.subjectId}
                onChange={handleSessionInputChange}
                min="1"
                placeholder="Оставьте пустым для ближайшего занятия"
              />
            </div>

            <div className="form-group">
              <label htmlFor="groupIds">Group IDs (через запятую, опционально)</label>
              <input
                id="groupIds"
                type="text"
                name="groupIds"
                value={sessionForm.groupIds}
                onChange={handleSessionInputChange}
                placeholder="1, 2, 3"
              />
            </div>

            <div className="form-group">
              <label htmlFor="lessonName">Lesson name (опционально)</label>
              <input
                id="lessonName"
                type="text"
                name="lessonName"
                value={sessionForm.lessonName}
                onChange={handleSessionInputChange}
                placeholder="Networks"
              />
            </div>

            <div className="form-group">
              <label htmlFor="expiresMinutes">Expires minutes</label>
              <input
                id="expiresMinutes"
                type="number"
                name="expiresMinutes"
                value={sessionForm.expiresMinutes}
                onChange={handleSessionInputChange}
                min="1"
                max="1440"
              />
            </div>

            <button type="submit" className="submit-btn" disabled={sessionLoading}>
              {sessionLoading ? 'Создание...' : 'Создать ссылку'}
            </button>
            <button type="button" className="copy-btn" onClick={handleCreateNearestSession} disabled={sessionLoading}>
              {sessionLoading ? 'Создание...' : 'Создать по расписанию'}
            </button>
          </form>

          {sessionError && <div className="error-message">{sessionError}</div>}

          {sessionResult && (
            <div className="session-result">
              <h3>Сессия создана успешно!</h3>
              <div className="result-item">
                <label>Join URL:</label>
                <div className="result-value clickable">{sessionResult.join_url || 'Не получена'}</div>
              </div>
              <div className="result-item">
                <label>Invite token:</label>
                <div className="result-value clickable">{sessionResult.invite_token || 'Не получена'}</div>
              </div>
              {sessionResult.lesson_id && (
                <div className="result-item">
                  <label>Lesson ID:</label>
                  <div className="result-value">{sessionResult.lesson_id}</div>
                </div>
              )}
              {sessionResult.subject_id != null && (
                <div className="result-item">
                  <label>Subject ID:</label>
                  <div className="result-value">{sessionResult.subject_id}</div>
                </div>
              )}
              {sessionResult.group_ids && sessionResult.group_ids.length > 0 && (
                <div className="result-item">
                  <label>Group IDs:</label>
                  <div className="result-value">{sessionResult.group_ids.join(', ')}</div>
                </div>
              )}
              {sessionResult.schedule_start && (
                <div className="result-item">
                  <label>Начало:</label>
                  <div className="result-value">{new Date(sessionResult.schedule_start).toLocaleString('ru-RU')}</div>
                </div>
              )}
              {sessionResult.schedule_end && (
                <div className="result-item">
                  <label>Конец:</label>
                  <div className="result-value">{new Date(sessionResult.schedule_end).toLocaleString('ru-RU')}</div>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {activeTab === 'statistics' && (
        <div className="teacher-section">
          <h2>Преподаватель: статистика группы</h2>
          <form onSubmit={handleGetStats} className="teacher-form">
            <div className="form-group">
              <label htmlFor="statGroupId">Group ID</label>
              <input
                id="statGroupId"
                type="number"
                name="groupId"
                value={statsForm.groupId}
                onChange={handleStatsInputChange}
                min="1"
                required
              />
            </div>
            <div className="form-group">
              <label htmlFor="statSubjectId">Subject ID (опционально)</label>
              <input
                id="statSubjectId"
                type="number"
                name="subjectId"
                value={statsForm.subjectId}
                onChange={handleStatsInputChange}
                min="1"
                placeholder="Оставьте пустым для всех предметов"
              />
            </div>
            <button type="submit" className="submit-btn" disabled={statsLoading}>
              {statsLoading ? 'Загрузка...' : 'Загрузить посещаемость'}
            </button>
          </form>

          {statsError && <div className="error-message">{statsError}</div>}

          {statsResult && (
            <div className="stats-result">
              <h3>Таблица посещаемости</h3>
              <table className="stats-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Присутствия</th>
                    <th>Всего</th>
                    <th>%</th>
                  </tr>
                </thead>
                <tbody>
                  {statsResult.students && statsResult.students.length > 0 ? (
                    statsResult.students.map((student, idx) => {
                      const percent = Number(student.attendance_percent);
                      return (
                        <tr key={idx}>
                          <td>{student.student_id}</td>
                          <td>{student.student_name}</td>
                          <td>{student.attended_sessions}</td>
                          <td>{student.total_sessions}</td>
                          <td>{Number.isFinite(percent) ? percent.toFixed(1) + '%' : 'N/A'}</td>
                        </tr>
                      );
                    })
                  ) : (
                    <tr><td colSpan={5}>Нет данных</td></tr>
                  )}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )}

      {activeTab === 'charts' && (
        <div className="teacher-section">
          <h2>Графики успеваемости и посещаемости</h2>
          <form onSubmit={handleGetStats} className="teacher-form">
            <div className="form-group">
              <label htmlFor="chartGroupId">Group ID</label>
              <input
                id="chartGroupId"
                type="number"
                name="groupId"
                value={statsForm.groupId}
                onChange={handleStatsInputChange}
                min="1"
                required
              />
            </div>
            <div className="form-group">
              <label htmlFor="chartSubjectId">Subject ID (опционально)</label>
              <input
                id="chartSubjectId"
                type="number"
                name="subjectId"
                value={statsForm.subjectId}
                onChange={handleStatsInputChange}
                min="1"
                placeholder="Оставьте пустым для всех предметов"
              />
            </div>
            <button type="submit" className="submit-btn" disabled={statsLoading}>
              {statsLoading ? 'Загрузка...' : 'Показать графики'}
            </button>
          </form>

          {statsError && <div className="error-message">{statsError}</div>}

          {statsResult && (
            <div className="charts-result">
              <h3>Посещаемость по студентам</h3>
              <ResponsiveContainer width="100%" height={350}>
                <BarChart data={attendanceData} margin={{ top: 20, right: 20, left: 0, bottom: 5 }}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="name" />
                  <YAxis domain={[0, 100]} />
                  <Tooltip />
                  <Legend />
                  <Bar dataKey="attendance" fill="#8884d8" name="Посещаемость (%)" />
                </BarChart>
              </ResponsiveContainer>
              <div className="chart-summary">
                <p>Средняя посещаемость по всем студентам: <strong>{averageAttendance !== null ? averageAttendance.toFixed(1) + '%' : 'N/A'}</strong></p>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
};

export default TeacherAccount;
