{
  "name": "student-dashboard",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.19.0",
    "date-fns": "^2.30.0",
    "react": "18.2.0",
    "react-calendar": "^4.6.0",
    "react-dom": "18.2.0"
  },
  "scripts": {
    "start": "vite",
    "check-api": "swagger2openapi ../backend/docs/swagger.json --outfile /tmp/ejournal-openapi-v3.json && openapi-typescript /tmp/ejournal-openapi-v3.json --output ./src/services/schema.d.ts && tsc --project jsconfig.json --noEmit",
    "build": "vite build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
