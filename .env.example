# =================================================================
# Production Environment Configuration for ezachetka.ru
# =================================================================

# 1. Main Domain & Gateway Ports (Standard HTTPS 443 & HTTP 80)
DOMAIN=ezachetka.ru
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
SITE_BASE_URL=https://ezachetka.ru
APP_PORT=8888

# 2. CORS & Trusted Proxies
CORS_ALLOW_ORIGINS=https://ezachetka.ru,https://www.ezachetka.ru,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8888
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# 3. Security, Authentication & Role Hashes
JWT_SECRET=generate-a-secure-random-jwt-secret-for-production
ROLE_HASH_TEACHER=TEACHER-HASH-2026
ROLE_HASH_STUDENT=STUDENT-HASH-2026
DEFAULT_STUDENT_GROUP_ID=1
ALLOW_EARLY_ATTENDANCE=true
UPLOAD_DIR=uploads
METRICS_TOKEN=generate-a-secure-metrics-token

# 4. Legal, Support & Compliance Configuration (152-FZ / RKN / DMCA)
# These values are injected dynamically into the frontend without rebuilding images
ORGANIZATION_NAME=Электронный журнал ezachetka.ru
SUPPORT_EMAIL=support@ezachetka.ru
ABUSE_EMAIL=support@ezachetka.ru
FEEDBACK_TELEGRAM=
DISPUTE_TIMEFRAME_DAYS=7

# 5. Database (PostgreSQL)
POSTGRES_DB=ejournal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DB_DSN=postgres://postgres:replace-with-strong-postgres-password@postgres:5432/ejournal?sslmode=disable

# 6. Mail Server (SMTP)
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_USER=noreply@ezachetka.ru
SMTP_PASSWORD=replace-with-strong-mail-password
SMTP_FROM=noreply@ezachetka.ru
SMTP_TLS_SERVER_NAME=ezachetka.ru
SMTP_CA_FILE=

# 7. Azimutt Schema Visualizer
AZIMUTT_PORT=4000
AZIMUTT_HOST=ezachetka.ru
AZIMUTT_SECRET_KEY_BASE=generate-a-random-64-character-secret-key-base
DB_BACKUPS_DIR=./backups
AZIMUTT_AUTH_PASSWORD=true
